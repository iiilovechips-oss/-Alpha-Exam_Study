CANVAS_API_URL=https://canvas.youruniversity.edu
# Leave empty to use your browser login (a Chrome window opens when the session has expired).
# If Canvas admins ever issue you a token, paste it here and the browser is no longer used.
CANVAS_API_TOKEN=
# Optional: comma-separated course IDs to sync (see `canvas-sync courses`). Empty = all active courses.
CANVAS_COURSE_IDS=
# Seconds to wait for you to log in before giving up with a reminder.
CANVAS_LOGIN_TIMEOUT=300
